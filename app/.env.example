# === App (Vercel + local .env.local) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_EXPOSE

# Post-merge evidence is trusted from the workflow. No GitHub PAT is required.
MERGE_TRIGGER_SECRET=LONG_RANDOM_VALUE_SAME_AS_POST_MERGE_WORKFLOW_SECRET
# Optional internal token for manually publishing Arkiv attestations
WORKER_API_SECRET=DIFFERENT_LONG_RANDOM_INTERNAL_API_SECRET

# Select one provider: 0g or openai. Only the selected provider needs credentials.
AI_PROVIDER=0g
# 0G Private Computer (backend only, never the browser)
OG_API_KEY=YOUR_0G_API_KEY
OG_MODEL=MODEL_ID_FROM_PC_0G_AI_MODELS
# OpenAI (backend only, never the browser)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Arc Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_TREASURY_ADDRESS=DEPLOYED_ARC_TESTNET_CONTRACT_ADDRESS
PAYOUT_VOUCHER_SIGNER_KEY=SERVER_ONLY_SEPARATE_TEST_WALLET_PRIVATE_KEY

# Arkiv Rabdi (backend only)
ARKIV_ACCESS_KEY=ACCESS_KEY_FROM_HUB_ARKIV_NETWORK
ARKIV_WRITER_PRIVATE_KEY=TEST_WALLET_WITH_TGLM

# Backend token for the CRE report endpoint. CLI credentials belong in cre/.env only.
CRE_EXTERNAL_REPORT_TOKEN=SECRET_FOR_CRE_REPORT_ENDPOINT


# Public issuer wallet address; Vercel server uses it to restrict every Arkiv read.
ARKIV_ISSUER_ADDRESS=PUBLIC_RABDI_WRITER_WALLET_ADDRESS

# Local Arkiv publishing script only: target hosted app URL.
POC_APP_URL=https://YOUR_DEPLOYED_VERCEL_APP


# thirdweb: public client and private server key must belong to the SAME application.
# Enable GitHub authentication and allow the local/deployed domains in its dashboard.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=YOUR_THIRDWEB_CLIENT_ID
THIRDWEB_SECRET_KEY=SERVER_ONLY_THIRDWEB_SECRET_KEY

